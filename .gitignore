# .gitignore for syspilot

# ======================================
# Dogfooding: syspilot uses itself
# .syspilot/ is created by setup agent
# ======================================
.syspilot/
!.syspilot/ontology.toml
.jarvis/
.jarvis-v1/
.jarvis-v2/
.vscode/
managers/
projects/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/

# Auto-generated docs
docs/ontology-reference.md
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Sphinx build output
docs/_build/

# Local config that shouldn't be shared
.env
*.local

# github files
.github/dictation.md

# temporary files
temp/

# build artifacts
docs/build.log

# jarvis runtime hooks (installed/generated locally, not product content)
.github/hooks/

# BEGIN JARVIS MANAGED (see jarvis.gitignore.autoManage)
.jarvis/logs/
.jarvis/messages/
.jarvis/state/
.jarvis/heartbeat.yaml
.jarvis/reminders.yaml
.jarvis/syspilot-state.json
jarvis-*
# END JARVIS MANAGED

