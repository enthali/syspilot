# .gitignore for syspilot

# ======================================
# Dogfooding: syspilot uses itself
# .syspilot/ is created by setup agent
# ======================================
.syspilot/
!.syspilot/ontology.toml
.jarvis/
.vscode/
managers/
projects/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/

# Auto-generated docs
docs/ontology-reference.md
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Sphinx build output
docs/_build/

# Local config that shouldn't be shared
.env
*.local

# temporary files
temp/

# build artifacts
docs/build.log

# jarvis temp files
temp_messages.txt

# jarvis runtime hooks (installed/generated locally, not product content)
.github/hooks/

# installed instructions (not yet shared in the public MIT repo)
.github/instructions/

